# Optional for trusted local development only. Public deployments use the visitor's
# per-tab API key and should not configure a shared OPENAI_API_KEY.
# OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2
SPEC_WEB_ENABLE_OPENAI_RUNS=1
SPEC_WEB_REQUIRE_USER_API_KEY=1

# Optional. Defaults to local data/ in development and /tmp/speculative-web on Vercel.
# SPEC_WEB_DATA_DIR=
