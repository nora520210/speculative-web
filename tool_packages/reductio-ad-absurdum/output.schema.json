  "properties": {
    "accepted_claim": { "type": "string" },
    "extreme_extension": { "type": "string" },
    "absurd_outcome": { "type": "string" },
    "revealed_problem": { "type": "string" },
    "critical_artifact_or_task": { "type": "string" },
    "hidden_dependencies": {
