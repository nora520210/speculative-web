      "items": { "type": "string" }
    },
    "critical_discussion": {
      "type": "array",
      "items": { "type": "string" }
    },
    "absurd_artifact_brief": { "type": "string" },
    "process_or_system_visual_prompt": { "type": "string" },
    "semantic_summary": { "type": "string" }
  },
  "additionalProperties": false
}
