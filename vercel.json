{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__path=/api/:path*"
    },
    {
      "source": "/tool-assets/:path*",
      "destination": "/api/index.py?__path=/tool-assets/:path*"
    },
    {
      "source": "/generated/:path*",
      "destination": "/api/index.py?__path=/generated/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.py?__path=/uploads/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/index.py?__path=/:path*"
    }
  ]
}
